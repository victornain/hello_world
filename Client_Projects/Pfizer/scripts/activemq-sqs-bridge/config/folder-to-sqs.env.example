# folder-to-sqs (PFIZER service): reads the XML files written by amq-to-folder and pushes them to SQS.
#
# Run without Docker (copy this file to e.g. config/pfizer.env first; keep secrets out of git):
#   java -jar folder-to-sqs/target/folder-to-sqs.jar --config config/pfizer.env
# Real environment variables override values in this file. Comments must be on their own lines.

# Fallback SourceSite for files without a .properties sidecar; also the FIFO MessageGroupId
SITE_ID=ANDOVER

# AWS SQS. A .fifo URL enables FIFO dedup (same dedup id as amq-to-sqs, so re-sends are dropped).
AWS_REGION=
SQS_QUEUE_URL=https://sqs.REGION.amazonaws.com/ACCOUNT_ID/exception-in
# Credentials: AWS default chain (env vars, ~/.aws, IAM role), or set one of these here:
#AWS_PROFILE=
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_SESSION_TOKEN=
#SQS_ENDPOINT_OVERRIDE=https://vpce-xxxx.sqs.REGION.vpce.amazonaws.com

# Folder shared with amq-to-folder
MESSAGE_FOLDER=./data/messages
# How often the folder is scanned for new files (same duration format as ACTIVEMQ_POLL_INTERVAL)
FOLDER_POLL_INTERVAL=30s
# Sent files are moved here (default <MESSAGE_FOLDER>/processed), or deleted if DELETE_AFTER_SEND=true
#PROCESSED_DIR=./data/messages/processed
#DELETE_AFTER_SEND=false
# Files SQS permanently rejects (too large, invalid characters) are moved here with a .reason.txt
FAILED_MESSAGE_DIR=./data/failed-sqs
# SourceQueue attribute for files dropped in by hand (no sidecar)
#ACTIVEMQ_QUEUE=PROCESS_EXCEPTION_RECORD_EXTERNALLY_REQUEST

#XSD_PATH=./schemas/RAExternalExceptionHandling.xsd
#SQS_MAX_MESSAGE_BYTES=262144
#RETRY_INITIAL_DELAY_MS=1000
#RETRY_MAX_DELAY_MS=60000
