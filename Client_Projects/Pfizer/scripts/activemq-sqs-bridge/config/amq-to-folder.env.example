# amq-to-folder (LOCAL service): polls ActiveMQ and saves each XML message to a local folder.
# The Pfizer-side folder-to-sqs service picks the files up and pushes them to SQS.
#
# Run without Docker (copy this file to e.g. config/local.env first; keep secrets out of git):
#   java -jar amq-to-folder/target/amq-to-folder.jar --config config/local.env
# Real environment variables override values in this file. Comments must be on their own lines.

SITE_ID=ANDOVER

# ActiveMQ (OpenWire)
ACTIVEMQ_URL=tcp://aznaampstalos1i.ra-int.com:61646
ACTIVEMQ_QUEUE=PROCESS_EXCEPTION_RECORD_EXTERNALLY_REQUEST
ACTIVEMQ_USER=admin
# Or ACTIVEMQ_PASSWORD_FILE=/path/to/amq_password
ACTIVEMQ_PASSWORD=admin
#ACTIVEMQ_SSL_TRUSTSTORE=/certs/truststore.jks
#ACTIVEMQ_SSL_TRUSTSTORE_PASSWORD=
#ACTIVEMQ_USE_FAILOVER=true

# How often ActiveMQ is polled. Each poll drains every message currently in the queue, then the
# service disconnects and sleeps for this long. Change it here (e.g. 5m -> 10m) and restart; no code change.
# Units: ms, s, m, h, d (combinable, e.g. 1h30m) or ISO-8601 (PT10M). 0 = consume continuously.
ACTIVEMQ_POLL_INTERVAL=5m
# How long one receive waits for the next message before the poll is considered finished
#ACTIVEMQ_RECEIVE_TIMEOUT_MS=1000

# Where XML files are written (<timestamp>_<JMS id>.xml + .properties metadata sidecar)
MESSAGE_FOLDER=./data/messages
# Messages that are not Text/Bytes JMS messages
FAILED_MESSAGE_DIR=./data/failed

#RETRY_INITIAL_DELAY_MS=1000
#RETRY_MAX_DELAY_MS=60000
