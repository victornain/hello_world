# sqs-to-amq: one file per PharmaSuite site (each site has its own broker).
# docker run -d --name sqs-to-amq-andover --env-file andover-out.env sqs-to-amq:1.0.0
# NOTE: docker --env-file does not support inline comments; keep comments on their own lines.

# AWS SQS (source). TODO: region, account id and outbound queue name are not defined in the plan (Phase 5).
AWS_REGION=
SQS_QUEUE_URL=https://sqs.REGION.amazonaws.com/ACCOUNT_ID/OUTBOUND_QUEUE_NAME
#SQS_WAIT_TIME_SECONDS=20
#SQS_MAX_MESSAGES=10
# 0/unset = queue default
#SQS_VISIBILITY_TIMEOUT_SECONDS=60
#SQS_ENDPOINT_OVERRIDE=

# ActiveMQ (target). TODO: confirm EXCEPTION_RECORD_EXTERNAL_RESPONSE is the right queue for PRC push-back (Phase 5.1)
ACTIVEMQ_URL=tcp://aznaampstalos1i:61646
ACTIVEMQ_QUEUE=EXCEPTION_RECORD_EXTERNAL_RESPONSE
ACTIVEMQ_USER=
ACTIVEMQ_PASSWORD=
#ACTIVEMQ_SSL_TRUSTSTORE=/certs/truststore.jks
#ACTIVEMQ_SSL_TRUSTSTORE_PASSWORD=
#ACTIVEMQ_PERSISTENT=true
#ACTIVEMQ_MESSAGE_TTL_MS=0
