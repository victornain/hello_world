# amq-to-sqs: one file per PharmaSuite site. Copy to e.g. andover.env (*.env is docker-ignored).
# docker run -d --name amq-to-sqs-andover --env-file andover.env -v amq-failed-andover:/data/failed amq-to-sqs:1.0.0
# NOTE: docker --env-file does not support inline comments; keep comments on their own lines.

# Site identity for S2 tagging. TODO: agreed site codes (Andover / Grange Castle DP / Sanford)
SITE_ID=ANDOVER #<------------------------

# ActiveMQ (OpenWire). Justin's validation broker; production is ssl://<host>:61647 (TBD per site)
ACTIVEMQ_URL=tcp://aznaampstalos1i.ra-int.com:61646
ACTIVEMQ_QUEUE=PROCESS_EXCEPTION_RECORD_EXTERNALLY_REQUEST
ACTIVEMQ_USER=admin
# Or ACTIVEMQ_PASSWORD_FILE=/run/secrets/amq_password
ACTIVEMQ_PASSWORD=admin
# Required for ssl:// (TBD: certificates from Pfizer Core). Keystore only if the broker requires mutual TLS.
#ACTIVEMQ_SSL_TRUSTSTORE=/certs/truststore.jks
#ACTIVEMQ_SSL_TRUSTSTORE_PASSWORD=
#ACTIVEMQ_SSL_KEYSTORE=/certs/client.jks
#ACTIVEMQ_SSL_KEYSTORE_PASSWORD=
#ACTIVEMQ_USE_FAILOVER=true
#ACTIVEMQ_FAILOVER_OPTIONS=initialReconnectDelay=1000&maxReconnectDelay=30000&useExponentialBackOff=true&timeout=30000

# AWS SQS. TODO: region and account id are not defined in the plan. A .fifo URL enables FIFO dedup.
AWS_REGION= #<------------------------
SQS_QUEUE_URL=https://sqs.REGION.amazonaws.com/ACCOUNT_ID/exception-in #<------------------------
# Credentials use the AWS default chain. On-prem prefer IAM Roles Anywhere / AWS_PROFILE over static keys.
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
# If traffic must go through a VPC interface endpoint:
#SQS_ENDPOINT_OVERRIDE=https://vpce-xxxx.sqs.REGION.vpce.amazonaws.com
# The JVM ignores HTTPS_PROXY; use system properties instead if a proxy is needed:
#JAVA_OPTS=-XX:MaxRAMPercentage=75 -Dhttps.proxyHost=proxy.example -Dhttps.proxyPort=8080

# Behaviour
# Optional XSD validation; adds the SchemaValid message attribute
#XSD_PATH=/schemas/RAExternalExceptionHandling.xsd
#SQS_MAX_MESSAGE_BYTES=262144
#FAILED_MESSAGE_DIR=/data/failed
#RETRY_INITIAL_DELAY_MS=1000
#RETRY_MAX_DELAY_MS=60000
