<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.pfizer.bridge</groupId>
    <artifactId>activemq-sqs-bridge</artifactId>
    <version>1.0.0</version>
  </parent>
  <artifactId>amq-to-sqs</artifactId>
  <packaging>jar</packaging>

  <properties>
    <app.mainClass>com.pfizer.bridge.amqtosqs.AmqToSqsApp</app.mainClass>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.pfizer.bridge</groupId>
      <artifactId>bridge-common</artifactId>
    </dependency>
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
      <version>2.2</version>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>secretsmanager</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.18.2</version>
    </dependency>
  </dependencies>

  <build>
    <finalName>amq-to-sqs</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
